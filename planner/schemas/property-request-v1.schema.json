{
  "type": "object",
  "required": [
    "schema",
    "version",
    "source",
    "changes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "companion-property-request"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "resourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*[^\\s\\u0000-\\u001F\\u007F][^\\u0000-\\u001F\\u007F]*$"
        },
        "resourceId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          ]
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "unitId",
          "property",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "unitId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            ]
          },
          "property": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "value": {}
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimactual.github.io/77th-Jsoc-Companion/schemas/property-request-v1.schema.json",
  "title": "Companion offline property request v1",
  "$comment": "Wire shape only. Runtime review enforces supported values, locked/missing targets, duplicate identities, source index identity, lossless canonical mission, byte cap and stale-plan protection. Unknown property names parse to explicit blocking diagnostics."
}
